# Complete unit for the verified q1220 / Ubuntu-22.04 host. Install as
# /etc/systemd/system/autoocr-business.service after backing up the old unit.
# Do not use an empty RequiresMountsFor= drop-in to reset systemd 249 paths.
[Unit]
Description=AutoOCR full business service (CPU, loopback only)
After=local-fs.target network.target
RequiresMountsFor=/home/q1220/projects/autoocr-business
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=exec
User=q1220
Group=q1220
WorkingDirectory=/home/q1220/projects/autoocr-business/releases/autoocr-business-cpu-20260918-r2/edge_deploy/business
Environment=HOME=/home/q1220
Environment=AUTOOCR_SOURCE_ROOT=/home/q1220/projects/autoocr-business/releases/autoocr-business-cpu-20260918-r2
Environment=AUTOOCR_RUNTIME_DIR=/home/q1220/projects/autoocr-business/runtime
Environment=AUTOOCR_BUSINESS_VENV=/home/q1220/projects/autoocr-business/.venv
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/home/q1220/projects/autoocr-business/.venv/bin/python /home/q1220/projects/autoocr-business/releases/autoocr-business-cpu-20260918-r2/edge_deploy/business/release_business.py verify --root /home/q1220/projects/autoocr-business/releases/autoocr-business-cpu-20260918-r2
ExecStart=/bin/bash /home/q1220/projects/autoocr-business/releases/autoocr-business-cpu-20260918-r2/edge_deploy/business/start_release.sh
ExecStartPost=/home/q1220/projects/autoocr-business/.venv/bin/python /home/q1220/projects/autoocr-business/releases/autoocr-business-cpu-20260918-r2/edge_deploy/business/service_health.py --wait-ready --timeout 180
TimeoutStartSec=240
TimeoutStopSec=90
KillMode=mixed
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
MemoryAccounting=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autoocr-business

[Install]
WantedBy=multi-user.target
